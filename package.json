{
  "name": "kiwi-debug-workspace",
  "private": true,
  "description": "Workspace of the kiwi-debug packages: a framework-agnostic in-page debug overlay.",
  "license": "MIT",
  "author": "Miya",
  "type": "module",
  "workspaces": [
    "packages/debug",
    "packages/debug-angular"
  ],
  "scripts": {
    "build": "npm run build -w packages/debug && npm run build -w packages/debug-angular",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p playground",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack:dry": "npm pack --dry-run --workspaces",
    "setup:playground": "node scripts/setup-playground.mjs",
    "playground": "vite playground"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "happy-dom": "^21.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@kiwi-js/dom": "file:../kiwi-dom"
  }
}
