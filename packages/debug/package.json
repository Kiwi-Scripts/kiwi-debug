{
  "name": "@kiwi-js/debug",
  "version": "0.0.0",
  "description": "Framework-agnostic in-page debug overlay: hover inspector, value tracking and diagnostic panels, driven by framework adapters.",
  "keywords": [
    "debug",
    "inspector",
    "overlay",
    "devtools",
    "kiwi"
  ],
  "license": "MIT",
  "author": "Miya",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiwi-Scripts/kiwi-debug.git",
    "directory": "packages/debug"
  },
  "homepage": "https://github.com/Kiwi-Scripts/kiwi-debug/tree/master/packages/debug#readme",
  "bugs": {
    "url": "https://github.com/Kiwi-Scripts/kiwi-debug/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.ts",
        "default": "./dist/adapter.js"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./testkit": {
      "import": {
        "types": "./dist/testkit.d.ts",
        "default": "./dist/testkit.js"
      },
      "require": {
        "types": "./dist/testkit.d.cts",
        "default": "./dist/testkit.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "adapter": ["./dist/adapter.d.ts"],
      "testkit": ["./dist/testkit.d.ts"]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@kiwi-js/dom": "^0.0.0"
  },
  "peerDependencies": {
    "@kiwi-js/panels": ">=0.0.0"
  },
  "devDependencies": {
    "@kiwi-js/panels": "file:../../../kiwi-panels"
  }
}
