{
  "name": "@kiwi-js/debug-angular",
  "version": "0.0.0",
  "description": "Angular adapter for @kiwi-js/debug: lets the in-page debug overlay inspect Angular components, signals, forms and rendering.",
  "keywords": [
    "angular",
    "debug",
    "inspector",
    "devtools",
    "kiwi"
  ],
  "license": "MIT",
  "author": "Miya",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiwi-Scripts/kiwi-debug.git",
    "directory": "packages/debug-angular"
  },
  "homepage": "https://github.com/Kiwi-Scripts/kiwi-debug/tree/master/packages/debug-angular#readme",
  "bugs": {
    "url": "https://github.com/Kiwi-Scripts/kiwi-debug/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@kiwi-js/debug": "^0.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@kiwi-js/debug": "^0.0.0",
    "rxjs": "^7.8.2",
    "zone.js": "~0.16.0"
  }
}
